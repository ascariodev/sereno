{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Sereno",
  "version": "0.1.1",
  "identifier": "dev.ascario.sereno",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Sereno",
        "visible": false,
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost https://sereno-api.ascario.dev wss://sereno-ws.ascario.dev",
        "img-src": "'self' asset: http://asset.localhost blob: data: https://sereno-api.ascario.dev",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:"
      },
      "devCsp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost http://localhost:8003 ws://localhost:8086 ws://localhost:5174",
        "img-src": "'self' asset: http://asset.localhost blob: data: http://localhost:8003",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBRjU2OTlCMDk5MDBBQUQKUldTdENwQUptMm4xMnVSeElId1RsS1hheGVlN3E1T3JXZS9sekVlenNJVDd1enl0UVZVUkdrVEoK",
      "endpoints": [
        "https://sereno.ascario.dev/desktop/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
